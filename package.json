{
  "name": "apex",
  "version": "1.0.0",
  "description": "Apex - a client-side karting telemetry and leaderboard app",
  "scripts": {
    "start": "npx serve src -p 3000",
    "test": "playwright test",
    "validate:data": "node scripts/validate-dataset.js && node scripts/sync-demo-data.js --check",
    "generate:data": "node scripts/generate-demo-data.js && node scripts/sync-demo-data.js",
    "screenshots": "playwright test --config playwright.screenshots.config.js",
    "sync:demo": "node scripts/sync-demo-data.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neilweitzel/Apex-Race-Telemetry.git"
  },
  "keywords": [
    "karting",
    "telemetry",
    "leaderboard",
    "gpx"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/neilweitzel/Apex-Race-Telemetry/issues"
  },
  "homepage": "https://neilweitzel.github.io/Apex-Race-Telemetry/",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "serve": "^14.2.6"
  }
}
